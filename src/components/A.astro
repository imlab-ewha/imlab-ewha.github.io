---
// A link that opens external sites safely and resolves internal paths against the site root.
import { isExternal, u } from '../lib/site';
interface Props { href: string; class?: string; 'aria-label'?: string }
const { href, class: className, ...rest } = Astro.props;
---
<a href={u(href)} class={className} rel={isExternal(href) ? 'noopener noreferrer' : undefined} {...rest}><slot /></a>
